:root {
  --bg: #fffaf2;
  --surface: #ffffff;
  --surface-soft: #f4f0ea;
  --primary: #0f5b3e;
  --primary-dark: #0a4331;
  --primary-light: #dff5ea;
  --accent: #f4b33e;
  --text: #17212b;
  --muted: #5a6470;
  --line: #e8e1d7;
  --success: #188b5f;
  --warning: #d8751a;
  --shadow: 0 14px 30px rgba(17, 37, 31, 0.08);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: linear-gradient(180deg, #fffaf2 0%, #fff 100%);
  color: var(--text);
}

img {
  max-width: 100%;
  display: block;
}

a {
  text-decoration: none;
  color: inherit;
}

button,
input,
textarea {
  font: inherit;
}

#root {
  min-height: 100vh;
}

.container {
  width: min(1120px, calc(100vw - 40px));
  margin: 0 auto;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 50;
  backdrop-filter: blur(14px);
  background: rgba(255, 250, 242, 0.9);
  border-bottom: 1px solid rgba(23, 33, 43, 0.06);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 0;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--primary), #165f4f);
  color: white;
  font-weight: 800;
}

.brand-name {
  display: block;
  font-weight: 800;
  color: var(--primary-dark);
}

.brand small {
  display: block;
  color: var(--muted);
  font-size: 12px;
}

nav {
  display: flex;
  align-items: center;
  gap: 20px;
  color: var(--muted);
  font-size: 14px;
}

nav a:hover {
  color: var(--primary);
}

.hero {
  padding: 72px 0 36px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 28px;
  align-items: center;
}

.eyebrow {
  display: inline-flex;
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--primary);
  font-weight: 700;
  background: var(--primary-light);
  padding: 8px 12px;
  border-radius: 999px;
}

.hero-copy h1 {
  font-size: clamp(2.5rem, 5vw, 4.4rem);
  line-height: 1.04;
  margin: 18px 0 14px;
  color: var(--primary-dark);
}

.hero-copy p {
  margin: 0;
  padding-right: 30px;
  font-size: 1.1rem;
  line-height: 1.7;
  color: var(--muted);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 28px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 12px;
  padding: 14px 22px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.btn:hover {
  transform: translateY(-1px);
}

.btn.primary {
  background: linear-gradient(135deg, var(--primary), #1a6d50);
  color: #fff;
  box-shadow: 0 12px 24px rgba(15, 91, 62, 0.2);
}

.btn.secondary {
  background: var(--surface-soft);
  color: var(--primary-dark);
}

.btn.small {
  padding: 10px 16px;
  font-size: 14px;
}

.hero-points {
  list-style: none;
  padding: 0;
  margin: 26px 0 0;
  display: grid;
  gap: 10px;
}

.hero-points li {
  position: relative;
  padding-left: 28px;
  color: var(--text);
  font-weight: 500;
}

.hero-points li::before {
  content: '✓';
  position: absolute;
  left: 0;
  width: 20px;
  height: 20px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 12px;
  font-weight: 800;
}

.panel {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 22px;
  box-shadow: var(--shadow);
}

.hero-panel {
  padding: 22px;
  background: linear-gradient(180deg, #fbfaf7, #ffffff);
}

.mini-header {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  color: var(--muted);
  margin-bottom: 18px;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
}

.dot.green {
  background: var(--success);
  box-shadow: 0 0 0 4px rgba(24, 139, 95, 0.15);
}

.insight-card {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 16px;
  margin-top: 14px;
}

.tag {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  background: #dff5ea;
  color: var(--primary);
  padding: 6px 8px;
  border-radius: 999px;
}

.tag.warning {
  background: #fff0dd;
  color: var(--warning);
}

.tag.success {
  background: #e8fff5;
  color: var(--success);
}

.insight-card strong {
  display: block;
  margin-top: 10px;
  font-size: 1.05rem;
}

.insight-card small {
  display: block;
  margin-top: 8px;
  color: var(--muted);
  line-height: 1.5;
}

.stats {
  padding: 18px 0 8px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.stats-grid > div {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 22px 18px;
  text-align: center;
}

.stats-grid strong {
  display: block;
  font-size: 1.2rem;
  color: var(--primary-dark);
}

.stats-grid span {
  display: block;
  color: var(--muted);
  margin-top: 6px;
}

.section {
  padding: 82px 0;
}

.alt {
  background: linear-gradient(180deg, #f6faf8, rgba(255, 255, 255, 0));
}

.section-heading {
  margin-bottom: 26px;
}

.section-heading h2 {
  margin: 14px 0 0;
  font-size: clamp(2rem, 3vw, 2.9rem);
  color: var(--primary-dark);
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.feature-card {
  padding: 26px 20px;
}

.icon {
  width: 56px;
  height: 56px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: var(--primary-light);
  font-size: 28px;
  margin-bottom: 18px;
}

.feature-card h3 {
  margin: 0 0 10px;
  color: var(--primary-dark);
}

.feature-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.workspace-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22px;
}

.input-panel,
.output-panel {
  padding: 22px;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 16px;
}

.panel-header h3 {
  margin: 0;
  color: var(--primary-dark);
}

.status-pill {
  padding: 7px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  background: #f1f4f7;
  color: var(--muted);
}

.status-pill.success {
  background: #eafaf2;
  color: var(--success);
}

textarea {
  width: 100%;
  resize: vertical;
  min-height: 320px;
  padding: 18px 16px;
  border-radius: 16px;
  border: 1px solid var(--line);
  background: #fff;
  color: var(--text);
  line-height: 1.7;
  outline: none;
}

textarea:focus {
  border-color: rgba(15, 91, 62, 0.5);
  box-shadow: 0 0 0 4px rgba(15, 91, 62, 0.08);
}

.actions-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  margin-top: 16px;
}

.upload-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 16px;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: #f9f7f4;
  color: var(--primary-dark);
  font-weight: 700;
  cursor: pointer;
  overflow: hidden;
}

.upload-btn input {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
}

.helper-text {
  margin: 10px 0 0;
  color: var(--muted);
  font-size: 14px;
}

.result-box {
  min-height: 260px;
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 18px 16px;
  background: linear-gradient(180deg, #fbfffd, #ffffff);
  white-space: pre-line;
  line-height: 1.8;
  color: var(--text);
  font-size: 15px;
}

.placeholder-text {
  margin: 0;
  color: var(--text);
}

.summary-box {
  margin-top: 16px;
  background: #fff9ed;
  border: 1px solid #f3d9a5;
  border-radius: 16px;
  padding: 16px 18px;
}

.summary-box h4 {
  margin: 0 0 10px;
  color: var(--primary-dark);
}

.summary-box ul {
  margin: 0;
  padding-left: 18px;
  color: var(--muted);
  line-height: 1.8;
}

.usecase-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.usecase-item {
  padding: 22px 20px;
}

.usecase-item h3 {
  margin: 0 0 12px;
  color: var(--primary-dark);
}

.usecase-item p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.glossary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.term {
  padding: 18px 16px;
  text-align: left;
}

.term span {
  color: var(--muted);
  display: block;
}

.term strong {
  display: block;
  margin-top: 8px;
  color: var(--primary-dark);
  font-size: 1.02rem;
  font-family: 'Noto Sans Malayalam', sans-serif;
}

.footer {
  border-top: 1px solid var(--line);
  background: #fff;
  padding: 28px 0;
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.footer h3 {
  margin: 0 0 6px;
  color: var(--primary-dark);
}

.footer p {
  margin: 0;
  color: var(--muted);
}

@media (max-width: 900px) {
  .hero-grid,
  .workspace-grid,
  .card-grid,
  .usecase-grid,
  .glossary-grid,
  .stats-grid {
    grid-template-columns: 1fr 1fr;
  }

  .hero-grid,
  .workspace-grid {
    grid-template-columns: 1fr;
  }

  nav {
    display: none;
  }
}

@media (max-width: 620px) {
  .card-grid,
  .usecase-grid,
  .glossary-grid,
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .hero {
    padding-top: 52px;
  }

  .footer-inner {
    flex-direction: column;
    align-items: flex-start;
  }
}
